# proxy-cam-2 — per-instance binding (ADR-0006, credential-free per ADR-0008).
# Copy to env/cam-2.env (gitignored) before `docker compose up`. Every value
# below must be present at startup; the proxy fails loudly rather than fall
# back to a hardcoded default. The camera username/password are NOT here —
# they arrive with each request from Frigate and are relayed to the camera.

# Upstream ONVIF camera (physical, on the LAN)
UPSTREAM_HOST=<IP>
UPSTREAM_PORT=<PORT>

# Local listener Ã¢â‚¬â€ keep in sync with the ports: mapping in docker-compose.yml
LISTEN_PORT=8080

# Logging: one of debug | info | warn | error; defaults to info.
LOG_LEVEL=info

# Camera binding (ADR-0003): spec-sheet defaults for the TP-Link Vigi C540-W
# v2 (4 mm lens). Override per unit after manual measurement (HFOV =
# 2Ã‚Â·atan(W/2D)); these are the cam-2 values as last measured.
HFOV_DEG=80
VFOV_DEG=43.2
PAN_MECH_DEG=350
TILT_MECH_DEG=120
