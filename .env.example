# Per-instance proxy configuration (template).
#
# One copy of this file per camera, referenced from docker-compose.yml via
# `env_file:` (ADR-0006, ADR-0007):
#
#   cp .env.example env/cam-1.env   -> env/cam-1.env
#   cp .env.example env/cam-2.env   -> env/cam-2.env
#
# Ready-made per-camera copies live next to this file as
# env/cam-1.env.example / env/cam-2.env.example. The real per-camera `.env`
# files are gitignored.
#
# Every key below is required at startup â€” the loader fails loudly instead of
# falling back to a hardcoded default. HFOV/VFOV/pan/tilt may be
# left at the spec-sheet defaults or overridden per unit (ADR-0003).
#
# There are NO camera credential keys: the proxy holds no password (ADR-0008).
# The client (Frigate) authenticates itself â€” its onvif: username/password
# travels inside each SOAP request and the proxy relays it to the camera.

# Upstream ONVIF camera (physical, on the LAN)
UPSTREAM_HOST=<IP>
UPSTREAM_PORT=<PORT>

# Local listener â€” must match the in-container port published by Compose
LISTEN_PORT=8080

# Logging: one of debug | info | warn | error; defaults to info.
LOG_LEVEL=info

# Camera binding (ADR-0003): spec-sheet defaults below; override per unit
# after manual measurement.
HFOV_DEG=80
VFOV_DEG=43.2
PAN_MECH_DEG=350
TILT_MECH_DEG=120
