{
  "name": "onvif-ptz-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "ONVIF PTZ proxy for Frigate autotracking. Forwards SOAP between Frigate and the upstream camera, injects TranslationSpaceFov into GetConfigurationOptions, and translates FOV-space RelativeMove to generic-space.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec \"test/integration/*.test.js\"",
    "test:single": "node --test --test-reporter=spec",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t ghcr.io/dunkiesa/vigi-c540w-frigate-ptz-proxy:latest .",
    "start": "node src/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
